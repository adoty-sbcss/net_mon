#!/usr/bin/env bash
# netmon-config-restore — pull the most recent (or specified) config backup
# from SFTP, extract it into /etc/netmon, restart containers.
#
# Usage:
#   sudo netmon-config-restore                  # most recent backup
#   sudo netmon-config-restore --date 2026-05-23
#   sudo netmon-config-restore --list           # show what's available
#
# Requires the collector container to be running (it does the SFTP download)
# and /etc/netmon/netmon.env to have valid SFTP creds. If you're recovering
# from a factory reset, that means: run the wizard FIRST (so SFTP creds are
# configured), then this script.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$REPO_DIR"

if [[ ${EUID} -ne 0 ]]; then
    exec sudo "$0" "$@"
fi

. "$REPO_DIR/lib/common.sh"
. "$REPO_DIR/lib/paths.sh"

ACTION="restore"
DATE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --list)        ACTION="list"; shift ;;
        --date)        DATE="$2"; shift 2 ;;
        --date=*)      DATE="${1#--date=}"; shift ;;
        -h|--help)
            cat <<'EOF'
Usage: sudo netmon-config-restore [--list | --date YYYY-MM-DD]

Downloads a NetMon config backup from SFTP and restores it into /etc/netmon.

Options:
  --list            Show available backups for this box on SFTP.
  --date <date>     Restore the backup for this date (default: most recent).
EOF
            exit 0 ;;
        *) die "unknown arg: $1" ;;
    esac
done

if ! docker compose ps --status running 2>/dev/null | grep -q netmon-collector; then
    die "collector container not running. Start it (./netmon restart) then re-run."
fi

if [[ "$ACTION" == "list" ]]; then
    docker compose exec -T collector python -m collector config-list
    exit $?
fi

OUT_FILE="/var/lib/netmon/config-restore.zip"
log "downloading config backup ${DATE:-(most recent)}"
if [[ -n "$DATE" ]]; then
    docker compose exec -T collector python -m collector config-download --date "$DATE" --out "$OUT_FILE"
else
    docker compose exec -T collector python -m collector config-download --out "$OUT_FILE"
fi

if [[ ! -s "$OUT_FILE" ]]; then
    die "downloaded file is empty or missing: $OUT_FILE"
fi

log "extracting into /etc/netmon (backing up current files first)"
ts="$(date -u +%Y%m%dT%H%M%SZ)"
for f in netmon.env snmp.yaml; do
    if [[ -f "/etc/netmon/$f" ]]; then
        cp -a "/etc/netmon/$f" "/etc/netmon/${f}.pre-restore-${ts}"
    fi
done

# Extract — only the two files we know about, to /etc/netmon.
# unzip is on every Ubuntu install but guard anyway.
if ! command -v unzip >/dev/null 2>&1; then
    log "installing unzip"
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq unzip >/dev/null
fi
unzip -o "$OUT_FILE" -d /etc/netmon/ "netmon.env" "snmp.yaml" 2>/dev/null || true

# Re-tighten perms
chmod 600 /etc/netmon/netmon.env 2>/dev/null || true
[[ -f /etc/netmon/snmp.yaml ]] && chmod 644 /etc/netmon/snmp.yaml
chown -R "$NETMON_OWNER_USER:$NETMON_OWNER_USER" /etc/netmon

# Drop the wizard sentinel so the operator knows this was restored, not first-boot.
touch /var/lib/netmon/.wizard-done

ok "config restored from backup"

log "restarting containers to pick up new config..."
docker compose restart

ok "done. Verify with:  ./netmon status   and   ./netmon upload-test"
echo ""
echo "Pre-restore backups saved as /etc/netmon/*.pre-restore-${ts}"
echo "Downloaded ZIP kept at $OUT_FILE"
