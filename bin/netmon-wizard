#!/usr/bin/env bash
# netmon-wizard — interactive setup wizard for /etc/netmon/netmon.env.
#
# Usage:
#   netmon-wizard               # full wizard (essentials -> ask advanced -> advanced)
#   netmon-wizard identity      # just the district/school/device prompts
#   netmon-wizard snmp          # just SNMP communities
#   netmon-wizard advanced      # just scan mode/cadence/log-level
#
# Designed to be called from:
#   - setup.sh        (final step of a fresh install)
#   - /etc/profile.d  (first SSH/console login on a freshly-imaged box)
#   - ./netmon menu   ("Configure" submenu)
#
# Creates /var/lib/netmon/.wizard-done after a successful full run so the
# profile.d auto-launch only triggers once per box.

set -euo pipefail

# Resolve the script's real location even when invoked via a symlink in
# /usr/local/sbin (which setup.sh installs).
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
LIB_DIR="$REPO_DIR/lib"

if [[ ! -d "$LIB_DIR" ]]; then
    echo "ERROR: lib/ not found relative to $SCRIPT_PATH" >&2
    exit 1
fi

# We always cd into the repo so relative paths (e.g. .env.example) resolve
# and so docker compose pickup uses ./docker-compose.yml.
cd "$REPO_DIR"

. "$LIB_DIR/common.sh"
. "$LIB_DIR/paths.sh"
. "$LIB_DIR/envfile.sh"
. "$LIB_DIR/provisioning.sh"
. "$LIB_DIR/validate.sh"
. "$LIB_DIR/identity.sh"
. "$LIB_DIR/snmp.sh"
. "$LIB_DIR/dashboard.sh"
. "$LIB_DIR/advanced.sh"
. "$LIB_DIR/trunk.sh"

WIZARD_SENTINEL="${NETMON_VAR_DIR}/.wizard-done"

# Always ensure the canonical paths exist before any prompt writes config.
ensure_paths

# Seed netmon.env from the repo template on the very first run so the prompts
# show sensible defaults instead of blank lines.
seed_env_from_example "$REPO_DIR/.env.example"

# Overlay any site provisioning defaults (dashboard URL, bootstrap key) so they
# appear pre-filled at the prompts.
# Only fills keys that are still empty — never clobbers an operator's value.
seed_env_from_provisioning

print_banner() {
    cat <<EOF

${C_HEAD}╔══════════════════════════════════════════════════════════════╗
║                  NetMon — first-boot wizard                  ║
╚══════════════════════════════════════════════════════════════╝${C_OFF}

This walks you through the settings the box needs to start collecting
and uploading. You can re-run any time with:  sudo netmon-wizard
Per-section runs:  sudo netmon-wizard identity | snmp | dashboard | trunk | advanced

Press Enter at any prompt to keep the current value (shown in brackets).

EOF
}

run_essentials() {
    prompt_identity_config

    # Auto-generate POSTGRES_PASSWORD if still the placeholder.
    local current_pgpw
    current_pgpw="$(current_value POSTGRES_PASSWORD)"
    if [[ -z "$current_pgpw" || "$current_pgpw" == "change-me-please" ]]; then
        local new_pgpw
        new_pgpw="$(openssl rand -hex 16 2>/dev/null || head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)"
        set_value POSTGRES_PASSWORD "$new_pgpw"
        log "Generated random POSTGRES_PASSWORD"
    fi

    # Bundle uploads need no prompts at all. The box ships over HTTPS to the
    # dashboard (bundle_transport=blob), which the dashboard arms remotely when
    # an admin marks the sensor installed — that's the staging guardrail, so a
    # box prepped at one site never uploads as if it were at its destination.
    # There is nothing here for a tech to type. (This used to walk them through
    # an SFTP host/user/password; the depot stopped accepting SFTP at the blob
    # cutover and the collector has no SFTP code left.)
    #
    # Keep the device-name default the upload path still tags bundles with. NOTE
    # the explicit `if` rather than `[[ ... ]] && set_value` — this is the last
    # statement in the function, so under `set -e` a false test would make
    # run_essentials return 1 and abort the wizard.
    if [[ -z "$(current_value NETMON_DEVICE_NAME)" ]]; then
        set_value NETMON_DEVICE_NAME "$(current_value NETMON_DEVICE)"
    fi
}

mark_wizard_done() {
    $SUDO install -m 644 -o "$NETMON_OWNER_USER" -g "$NETMON_OWNER_USER" \
        /dev/null "$WIZARD_SENTINEL"
}

run_full() {
    print_banner
    run_essentials
    prompt_snmp_config

    # Dashboard enrollment: if URL + bootstrap key are provisioned, skip the
    # prompts entirely — the box auto-enrolls on first check-in. Otherwise ask.
    if _dashboard_provisioned; then
        echo ""
        ok "Dashboard enrollment is pre-configured: $(current_value NETMON_DASHBOARD_URL)"
        echo "  (auto-enrolls on first check-in; change with: sudo netmon-wizard dashboard)"
    else
        prompt_dashboard_config
    fi

    # NOTE: VLAN trunk monitoring is offered by setup.sh AFTER the collector
    # container starts (so the wizard can auto-detect the trunk's VLANs — the
    # detector runs tshark inside that container). Run it any time standalone
    # with: sudo netmon-wizard trunk.

    echo ""
    if prompt_yesno "Set up advanced options now (scan mode, cadence, log level)?" "N"; then
        prompt_advanced_config
    else
        echo "  (skipped — change later with: sudo netmon-wizard advanced)"
    fi

    mark_wizard_done

    echo ""
    ok "wizard complete — settings written to $NETMON_ENV_FILE"
    echo ""
    echo "Useful next steps:"
    echo "  ./netmon status         # check container state"
    echo "  ./netmon upload-test    # verify the upload path"
    echo "  ./netmon                # interactive menu"
    echo ""
}

# --- dispatch -------------------------------------------------------------

case "${1:-}" in
    ""|all|full)   run_full ;;
    identity)      prompt_identity_config ;;
    snmp)          prompt_snmp_config ;;
    dashboard)     prompt_dashboard_config ;;
    advanced)      prompt_advanced_config ;;
    cadence)       prompt_scan_cadence ;;
    loglevel|log)  prompt_log_level ;;
    trunk|vlan)    prompt_trunk_config ;;
    -h|--help|help)
        sed -n '2,15p' "$0" | sed 's/^# //; s/^#//'
        ;;
    *)
        echo "ERROR: unknown section: $1" >&2
        echo "Try: identity | snmp | dashboard | advanced | cadence | loglevel | trunk" >&2
        exit 1
        ;;
esac
