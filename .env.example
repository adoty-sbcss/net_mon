# --- Postgres ---
POSTGRES_USER=appmon
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=appmon
POSTGRES_PORT=5432

# --- Collector behavior ---
# field   = one-shot scan per network plug-in, idle in between
# monitor = continuous collection, retain history
APPMON_MODE=field

# How long tshark captures control-plane traffic during a scan
APPMON_CAPTURE_SECONDS=60

# How often the poller checks interface state (seconds)
APPMON_POLL_INTERVAL=30

# Don't re-scan the same network within this window (seconds)
APPMON_COOLDOWN_SECONDS=300

# Substrings — any interface whose name starts with one of these is skipped
APPMON_EXCLUDE_IFACES=lo,docker0,br-,veth,virbr,tun,tap

# --- SNMP (optional) ---
# When true, the collector reads /etc/appmon/snmp.yaml for community strings.
# Default is false — only enable when you have authorization.
APPMON_SNMP_ENABLED=false
