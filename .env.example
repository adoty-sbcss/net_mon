# Reference template for /etc/netmon/netmon.env.
# DO NOT edit this file directly to configure a running box — it lives in the
# repo and gets overwritten by `git pull`. Instead:
#
#   - Fresh install:  run ./setup.sh, which seeds /etc/netmon/netmon.env
#                     from this file and then prompts you for values.
#   - Change a value: re-run ./setup.sh (it keeps current values as defaults)
#                     OR use the operator menu's Configure submenu.
#
# Canonical paths on a deployed box:
#   /etc/netmon/netmon.env    — this file, chmod 600
#   /etc/netmon/snmp.yaml     — SNMP per-device overrides (optional)
#   /var/lib/netmon/bundles/  — hourly ZIPs awaiting upload + recent uploads
#   /var/log/netmon/          — collector.log + audit.log (rotated)

# --- Postgres ---
POSTGRES_USER=netmon
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=netmon
POSTGRES_PORT=5432

# --- Box identity (set by the first-boot wizard in Phase 2) -----------------
# Slugs: lowercase, dashes, alphanumeric only. Drive scan_runs tagging today
# and the hierarchical SFTP path / bundle filenames in Phase 2.
NETMON_DISTRICT_SLUG=
NETMON_SCHOOL_SLUG=
NETMON_DEVICE_SLUG=

# Friendly name used in upload filenames. Defaults to the box's hostname if empty.
NETMON_DEVICE_NAME=

# --- Collector behavior ---

# Deployment profile. Use 'survey' for a mobile box (laptop carried to sites,
# Wi-Fi spectrum survey is the primary job, long Wi-Fi scans), or 'monitor'
# for a stationary box (wired collection primary, brief Wi-Fi snapshot once
# per hour). Defaults to 'monitor'. Set during ./setup.sh.
NETMON_PROFILE=monitor

# field   = one-shot scan per network plug-in, idle in between
# monitor = continuous collection, retain history
NETMON_MODE=field

# How long tshark captures control-plane traffic during a scan
NETMON_CAPTURE_SECONDS=60

# How often the poller checks interface state (seconds)
NETMON_POLL_INTERVAL=30

# Don't re-scan the same network within this window (seconds)
NETMON_COOLDOWN_SECONDS=300

# Substrings — any interface whose name starts with one of these is skipped
NETMON_EXCLUDE_IFACES=lo,docker0,br-,veth,virbr,tun,tap

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Default INFO.
# Files rotate nightly under /var/log/netmon/ (collector.log + audit.log).
NETMON_LOG_LEVEL=INFO

# --- SNMP (optional) ---
# When true, the collector polls SNMP against the default gateway, any
# LLDP-discovered switch management IPs, and any ARP/nmap entry whose vendor
# looks like network gear (Cisco, Aruba, Juniper, etc.).
NETMON_SNMP_ENABLED=false

# Comma-separated v2c communities to try, in order. The collector probes each
# one (short sysDescr GET) and caches the first that works, per device, in
# the snmp_credentials table. Future scans skip the trial.
NETMON_SNMP_COMMUNITIES=

# --- Wi-Fi monitoring (Phase 1, optional) ---
# Requires a Wi-Fi adapter that supports monitor mode (check with 'iw list').
# Set during ./setup.sh; uses the chosen profile to drive scan durations.
NETMON_WIFI_ENABLED=false
NETMON_WIFI_INTERFACE=
# Override the profile-driven scan duration if you want. 0 = use profile default.
NETMON_WIFI_SCAN_SECONDS=0
# Restrict to specific channels, e.g. "1,6,11,36,40,44". Empty = all supported.
NETMON_WIFI_CHANNELS=
# For monitor-profile boxes only: minute of the hour at which an auto Wi-Fi
# snapshot runs. Default 20 (sits between scan triggers at :00 and uploads at :00).
NETMON_WIFI_HOURLY_MINUTE=20

# --- SFTP hourly upload ---
# When enabled, the collector bundles the past hour's scans into a single ZIP
# and SFTPs it to the configured server at the top of every hour.
# Filename: <NETMON_DEVICE_NAME>_YYYY_MM_DD_HH.zip  (hour in local time)
# Run ./setup.sh to fill these in interactively — it's safer than editing here.
NETMON_SFTP_ENABLED=false
NETMON_SFTP_HOST=
NETMON_SFTP_PORT=22
NETMON_SFTP_USER=
NETMON_SFTP_PASSWORD=
NETMON_SFTP_REMOTE_PATH=/
