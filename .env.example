# Reference template for /etc/netmon/netmon.env.
# DO NOT edit this file directly to configure a running box — it lives in the
# repo and gets overwritten by `git pull`. Instead:
#
#   - Fresh install:  run ./setup.sh, which seeds /etc/netmon/netmon.env
#                     from this file and then prompts you for values.
#   - Change a value: re-run ./setup.sh (it keeps current values as defaults)
#                     OR use the operator menu's Configure submenu.
#
# Canonical paths on a deployed box:
#   /etc/netmon/netmon.env    — this file, chmod 600
#   /etc/netmon/snmp.yaml     — SNMP per-device overrides (optional)
#   /var/lib/netmon/bundles/  — hourly ZIPs awaiting upload + recent uploads
#   /var/log/netmon/          — collector.log + audit.log (rotated)

# --- Postgres ---
POSTGRES_USER=netmon
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=netmon
POSTGRES_PORT=5432

# --- Box identity (set by the first-boot wizard in Phase 2) -----------------
# Slugs: lowercase, dashes, alphanumeric only. Drive scan_runs tagging and the
# hierarchical upload path / bundle filenames.
NETMON_DISTRICT_SLUG=
NETMON_SCHOOL_SLUG=
NETMON_DEVICE_SLUG=

# Friendly name used in upload filenames. Defaults to the box's hostname if empty.
NETMON_DEVICE_NAME=

# --- Collector behavior ---
# The collector continuously monitors EVERY active network interface (the
# wired uplink, any associated Wi-Fi NIC, future VLAN sub-interfaces). Each
# network is re-scanned on the cadence below, so there's fresh data to bundle
# and upload every hour.

# Re-scan each active network at least this often (seconds). 3600 = hourly,
# matching the upload cadence. Lower = more frequent data + more load.
NETMON_RESCAN_INTERVAL=3600

# How long tshark captures control-plane traffic during a scan
NETMON_CAPTURE_SECONDS=60

# How often the poller checks interface state (seconds). This is just the
# tick rate; actual scan cadence is driven by NETMON_RESCAN_INTERVAL.
NETMON_POLL_INTERVAL=30

# Anti-flap floor: never scan the same network more than once per this many
# seconds, even on rapid link changes. Must be < NETMON_RESCAN_INTERVAL.
NETMON_COOLDOWN_SECONDS=300

# Substrings — any interface whose name starts with one of these is skipped.
# wlan interfaces are NOT excluded, so an associated Wi-Fi NIC is monitored
# automatically like any wired interface.
NETMON_EXCLUDE_IFACES=lo,docker0,br-,veth,virbr,tun,tap

# Logging verbosity: DEBUG, INFO, WARNING, ERROR. Default INFO.
# Files rotate nightly under /var/log/netmon/ (collector.log + audit.log).
NETMON_LOG_LEVEL=INFO

# --- SNMP ---
# When true, the collector polls SNMP against the default gateway, any
# LLDP-discovered switch management IPs, and any ARP/nmap entry whose vendor
# looks like network gear (Cisco, Aruba, Juniper, etc.).
#
# On by default: with no community set below this is a no-op, so the capability
# is simply armed and starts working the moment a community is provided (usually
# pushed from the dashboard per district). Set false to hard-disable a box.
NETMON_SNMP_ENABLED=true

# Comma-separated v2c communities to try, in order. The collector probes each
# one (short sysDescr GET) and caches the first that works, per device, in
# the snmp_credentials table. Future scans skip the trial.
NETMON_SNMP_COMMUNITIES=

# --- SNMP topology crawl ---
# When true, after the regular SNMP poll the collector walks each reachable
# device's lldpRemTable / lldpRemManAddrTable / cdpCacheTable, then recurses
# into discovered neighbors with depth + time budget caps. Requires SNMP read
# access to each switch you want to inventory; the same communities above
# are tried.
# On by default, but gated three ways: it needs SNMP enabled, a working
# community, AND it only runs once per NETMON_SNMP_TOPOLOGY_INTERVAL. Scope
# defaults to 'spine' (path-to-internet), not a full-fabric crawl.
NETMON_SNMP_TOPOLOGY_ENABLED=true
NETMON_SNMP_TOPOLOGY_MAX_DEPTH=5
NETMON_SNMP_TOPOLOGY_TIME_BUDGET=60

# --- Authoritative DHCP server intelligence (optional, opt-in) ---
# When true, the collector queries authorized Windows DHCP servers over WinRM
# (PowerShell DhcpServer module) for scopes, per-scope utilization, options, and
# failover — the authoritative view passive OFFER/ACK sniffing can't give. The
# server list + per-server WinRM credentials are NOT set here: they're pushed
# from the dashboard's authorized-DHCP-servers registry into a 0600
# /var/lib/netmon/dhcp-targets.json (secrets don't belong in this env file).
# Least-privilege: a domain account in the server's read-only "DHCP Users" group.
NETMON_DHCP_INTEL_ENABLED=false
NETMON_DHCP_INTEL_INTERVAL=3600

# --- DNS health probes ---
# Every scan, query a small set of test names against both the configured
# public resolvers AND whatever the host's /etc/resolv.conf advertises
# (DHCP-assigned or static). Measures latency, status, and answer correctness.
# Also sends a unique-per-scan NXDOMAIN probe to catch resolvers that rewrite
# bogus names to an ad/filter portal.
NETMON_DNS_ENABLED=true
NETMON_DNS_PUBLIC_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9
# Public names to resolve as DNS-health probes. Add your own org domain if you
# want to verify internal/split-horizon resolution (e.g. ...,yourcounty.k12.ca.us).
NETMON_DNS_TEST_NAMES=google.com,microsoft.com,cloudflare.com
NETMON_DNS_TIMEOUT_SEC=2
NETMON_DNS_INCLUDE_NXDOMAIN_PROBE=true

# --- Hourly bundle upload ---
# The collector bundles the past hour's scans into a single ZIP and ships it to
# the dashboard over HTTPS at the top of every hour.
# Filename: <NETMON_DEVICE_NAME>_YYYY_MM_DD_HH.zip  (hour in local time)
#
# Uploads are OFF until this is "blob". That's the staging guardrail: a box
# prepped at one site scans and bundles locally but pushes nothing, so it can't
# pollute its destination school. The dashboard flips it to "blob" when an admin
# marks the sensor installed — you should not need to set it by hand.
NETMON_BUNDLE_TRANSPORT=sftp

# --- Dashboard control plane + auto-enrollment (optional; outbound HTTPS) ----
# Let the box check in to the dashboard so admins can see it, push config, and
# run commands. Outbound HTTPS only — opens no inbound ports.
#
# These two values are the SAME on every box, so the recommended way to set
# them is NOT here but in a site provisioning file: copy
# config/provisioning.env.example to config/provisioning.env, fill in the URL
# and bootstrap key (from the dashboard's Settings -> Ingestion -> Sensor
# auto-enrollment), and the first-boot wizard pre-fills both prompts so the tech
# just presses Enter. See lib/provisioning.sh. The bootstrap key is a secret and
# this repo is public, so config/provisioning.env is git-ignored.
#
# Auto-enrollment flow: the box self-registers on first check-in using the
# shared bootstrap key + its identity slugs, then stores its own per-sensor
# token in /var/lib/netmon/enroll-token. (NETMON_ENROLL_TOKEN, if set, takes
# precedence and skips auto-enroll.)
NETMON_DASHBOARD_URL=
NETMON_BOOTSTRAP_KEY=
# NETMON_ENROLL_TOKEN=
