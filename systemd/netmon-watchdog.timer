[Unit]
Description=NetMon watchdog — periodic self-healing checks (every 15 min)
Documentation=https://github.com/adoty-sbcss/net_mon

[Timer]
# First run 5 min after boot, then every 15 min. Persistent=true catches
# up after the box was off, so a power-cut Sunday doesn't skip Monday's check.
OnBootSec=5min
OnUnitActiveSec=15min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
