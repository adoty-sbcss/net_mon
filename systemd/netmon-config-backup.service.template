[Unit]
Description=NetMon nightly config backup to SFTP
Documentation=https://github.com/adoty-sbcss/net_mon
After=network-online.target docker.service netmon-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=${USER}
Group=${USER}
WorkingDirectory=${REPO_DIR}
ExecStart=${REPO_DIR}/scripts/netmon-config-backup.sh
TimeoutStartSec=300
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
