[Unit]
Description=NetMon dashboard check-in (every ~3 minutes)
Documentation=https://github.com/adoty-sbcss/net_mon

[Timer]
# First run shortly after boot, then every 3 minutes. Latency for management
# actions (config/command pickup) = this interval. Interactive remote-console
# pairing uses the separate netmon-console-poll.timer (~30s), so this cadence is
# only the device check-in / desired-config / command-queue poll.
OnBootSec=2min
OnUnitActiveSec=3min
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
