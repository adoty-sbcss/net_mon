[Unit]
Description=NetMon dashboard check-in (every ~10 minutes)
Documentation=https://github.com/adoty-sbcss/net_mon

[Timer]
# First run shortly after boot, then every 10 minutes. Latency for management
# actions = this interval; fine for config/commands (not interactive control).
OnBootSec=3min
OnUnitActiveSec=10min
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
