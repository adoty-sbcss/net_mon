# Force LF endings for files that must work on Linux/Ubuntu.
# Without this, Windows clones can introduce CRLF and break shell scripts.

* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
Dockerfile  text eol=lf
Makefile    text eol=lf
.env*       text eol=lf
