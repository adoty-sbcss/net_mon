#!/usr/bin/env bash
# netmon — operator console for NetMon.
#
# Interactive:    ./netmon            (shows menu — main + submenus)
# Non-interactive ./netmon status     (jumps straight to that task)
#                 ./netmon scan eth0
#                 ./netmon upload-now
#                 ./netmon wizard     (run the full wizard)
#                 ./netmon help
#
# Designed for techs who don't want to memorize `docker compose exec collector
# python -m collector ...` commands. Every menu option wraps that for you.

set -euo pipefail
cd "$(dirname "$0")"

# --- shared helpers --------------------------------------------------------

# Source lib/common.sh + lib/paths.sh + lib/menu.sh if present (post-Phase-1
# boxes have them; older clones don't). Falls back to inline colors so the
# menu still works on a stale checkout.
if [[ -f ./lib/common.sh ]] && [[ -f ./lib/paths.sh ]] && [[ -f ./lib/menu.sh ]]; then
    . ./lib/common.sh
    . ./lib/paths.sh
    . ./lib/menu.sh
    [[ -f ./lib/version.sh ]] && . ./lib/version.sh
    [[ -f ./lib/lifecycle.sh ]] && . ./lib/lifecycle.sh
    # Cheap: ensure /etc/netmon + /var/lib/netmon exist and migrate any
    # legacy in-repo state into place.
    ensure_paths >/dev/null 2>&1 || true
    HAVE_LIB=1
else
    if [[ -t 1 ]]; then
        C_HEAD=$'\033[1;36m'; C_OK=$'\033[1;32m'; C_WARN=$'\033[1;33m'
        C_ERR=$'\033[1;31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
    else
        C_HEAD= C_OK= C_WARN= C_ERR= C_DIM= C_OFF=
    fi
    HAVE_LIB=0
fi

# Canonical paths. lib/paths.sh exports these; this fallback keeps the menu
# working on a stale checkout that hasn't pulled the Phase 1 refactor yet.
NETMON_BUNDLES_DIR="${NETMON_BUNDLES_DIR:-/var/lib/netmon/bundles}"
NETMON_LOG_DIR="${NETMON_LOG_DIR:-/var/log/netmon}"
NETMON_ENV_FILE="${NETMON_ENV_FILE:-/etc/netmon/netmon.env}"

# Use sudo for docker calls when the current user isn't yet in the docker group.
if id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
    DC=("docker" "compose")
else
    DC=("sudo" "docker" "compose")
fi

dc() { "${DC[@]}" "$@"; }

require_running() {
    if ! dc ps --status running 2>/dev/null | grep -q netmon-collector; then
        printf '%sCollector container is not running.%s\n' "$C_ERR" "$C_OFF" >&2
        echo "Run option 8 (Restart) from the menu, or 'docker compose up -d'." >&2
        return 1
    fi
}

pause_or_continue() {
    echo ""
    read -r -p "Press Enter to return to menu..." _ || true
}

# --- task implementations --------------------------------------------------

cmd_interfaces() {
    printf '%s== Monitored interfaces ==%s\n' "$C_HEAD" "$C_OFF"
    local primary
    primary="$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')"
    local found=0
    while read -r iface cidr; do
        case "$iface" in
            lo|docker0|br-*|veth*|virbr*|tun*|tap*) continue ;;
        esac
        found=1
        if [[ "$iface" == "$primary" ]]; then
            printf '  %b%-14s%b %-20s %bPRIMARY uplink%b\n' \
                "$C_OK" "$iface" "$C_OFF" "$cidr" "$C_OK" "$C_OFF"
        else
            printf '  %-14s %-20s secondary (monitored)\n' "$iface" "$cidr"
        fi
    done < <(ip -o -4 addr show scope global 2>/dev/null | awk '{print $2, $4}')
    [[ $found -eq 0 ]] && echo "  (no active interfaces with a usable IP yet)"
    echo ""
    if [[ -n "$primary" ]]; then
        echo "  Default gateway: $(ip route show default | awk '/default/ {print $3; exit}') via $primary"
    else
        printf '  %sNo default route — this box has no uplink yet.%s\n' "$C_WARN" "$C_OFF"
    fi
    printf '  %sEvery interface listed is scanned on the rescan interval (hourly by default).%s\n' "$C_DIM" "$C_OFF"
}

# Warn if the running collector image predates the checked-out collector code.
# This is the failure that sent uploads to the SFTP root: git was updated but
# the image was never rebuilt, so the container ran stale code that ignored the
# identity slugs. Degrades silently (no false warning) if docker/git aren't
# reachable.
image_staleness_warning() {
    local img_iso img_epoch code_epoch
    img_iso="$(docker image inspect netmon/collector:latest --format '{{.Created}}' 2>/dev/null \
        || sudo docker image inspect netmon/collector:latest --format '{{.Created}}' 2>/dev/null)"
    [[ -z "$img_iso" ]] && return 0
    img_epoch="$(date -d "$img_iso" +%s 2>/dev/null || echo 0)"
    code_epoch="$(git log -1 --format=%ct -- collector 2>/dev/null || echo 0)"
    if [[ "$img_epoch" -gt 0 && "$code_epoch" -gt 0 && "$code_epoch" -gt "$img_epoch" ]]; then
        printf '%s!! collector image is OLDER than the checked-out collector code%s\n' "$C_WARN" "$C_OFF"
        printf '   The running container is missing recent changes. Rebuild with:\n'
        printf '     docker compose build collector && docker compose up -d collector\n'
        printf '   (or let the nightly auto-update handle it)\n'
    fi
}

cmd_status() {
    printf '%s== Container status ==%s\n' "$C_HEAD" "$C_OFF"
    dc ps
    image_staleness_warning
    echo ""
    printf '%s== Identity ==%s\n' "$C_HEAD" "$C_OFF"
    if [[ -f "$NETMON_ENV_FILE" ]]; then
        sudo grep -E '^NETMON_(DISTRICT|SCHOOL|DEVICE)(_SLUG)?=' "$NETMON_ENV_FILE" 2>/dev/null \
            | sed 's/^/  /' \
            || echo "  (no identity set — run: sudo netmon-wizard identity)"
    fi
    echo ""
    printf '%s== Control plane / enrollment ==%s\n' "$C_HEAD" "$C_OFF"
    if [[ -f "$NETMON_ENV_FILE" ]]; then
        local cp_url cp_key cp_tok
        cp_url="$(sudo sed -nE 's/^NETMON_DASHBOARD_URL=//p' "$NETMON_ENV_FILE" 2>/dev/null | head -1 | tr -d '"')"
        cp_key="$(sudo sed -nE 's/^NETMON_BOOTSTRAP_KEY=//p'  "$NETMON_ENV_FILE" 2>/dev/null | head -1 | tr -d '"')"
        cp_tok="$(sudo sed -nE 's/^NETMON_ENROLL_TOKEN=//p'   "$NETMON_ENV_FILE" 2>/dev/null | head -1 | tr -d '"')"
        if [[ -n "$cp_url" ]]; then
            echo "  dashboard url: $cp_url"
        else
            echo "  dashboard url: ${C_WARN}(blank — collector falls back to baked default)${C_OFF}"
        fi
        if [[ -n "$cp_key" && -n "$cp_tok" ]]; then
            echo "  credential:    bootstrap-key + enroll-token"
        elif [[ -n "$cp_key" ]]; then
            echo "  credential:    bootstrap-key (auto-enroll)"
        elif [[ -n "$cp_tok" ]]; then
            echo "  credential:    enroll-token (manual)"
        else
            echo "  credential:    ${C_WARN}none — box cannot enroll${C_OFF}"
        fi
        # enrolled = the box has been issued (and stored) a per-sensor token
        local enrolled="(collector not running)"
        if dc ps --status running 2>/dev/null | grep -q netmon-collector; then
            if dc exec -T collector sh -c 'test -f /var/lib/netmon/enroll-token' 2>/dev/null; then
                enrolled="yes"
            else
                enrolled="${C_WARN}no — not yet enrolled${C_OFF}"
            fi
        fi
        printf "  enrolled:      %b\n" "$enrolled"
    fi
    echo ""
    cmd_interfaces
    echo ""
    printf '%s== Recent scans ==%s\n' "$C_HEAD" "$C_OFF"
    if require_running 2>/dev/null; then
        dc exec -T collector python -m collector list --limit 5 2>&1 || true
    fi
    echo ""
    printf '%s== Pending uploads ==%s\n' "$C_HEAD" "$C_OFF"
    if dc ps --status running 2>/dev/null | grep -q netmon-postgres; then
        dc exec -T postgres psql -U "${POSTGRES_USER:-netmon}" -d "${POSTGRES_DB:-netmon}" -c \
            "SELECT filename, built_at, uploaded_at, retry_count FROM bundle_uploads ORDER BY built_at DESC LIMIT 8;" 2>&1 || true
    fi
    echo ""
    printf '%s== Disk usage ==%s\n' "$C_HEAD" "$C_OFF"
    [[ -d "$NETMON_BUNDLES_DIR" ]] && du -sh "$NETMON_BUNDLES_DIR" 2>/dev/null || true
    [[ -d "$NETMON_LOG_DIR" ]] && du -sh "$NETMON_LOG_DIR" 2>/dev/null || true
    df -h "$NETMON_BUNDLES_DIR" 2>/dev/null | tail -2
}

cmd_logs() {
    printf '%s== Tailing collector logs (Ctrl-C to stop) ==%s\n' "$C_HEAD" "$C_OFF"
    dc logs -f --tail 50 collector
}

cmd_audit() {
    printf '%s== Audit log (last 50 lines) ==%s\n' "$C_HEAD" "$C_OFF"
    local audit_log="${NETMON_LOG_DIR}/audit.log"
    if [[ -f "$audit_log" ]]; then
        sudo tail -n 50 "$audit_log" 2>/dev/null || tail -n 50 "$audit_log"
    else
        echo "(no audit.log yet — runs once the collector has emitted an event)"
    fi
}

cmd_list_scans() {
    require_running || return 1
    dc exec -T collector python -m collector list
}

cmd_scan() {
    local iface="${1:-}"
    if [[ -z "$iface" ]]; then
        printf '%s== Interfaces with carrier ==%s\n' "$C_HEAD" "$C_OFF"
        ip -br addr 2>/dev/null | grep -v '^lo' || true
        echo ""
        read -r -p "Interface name (e.g. eth0, enp0s31f6): " iface || return 1
    fi
    [[ -z "$iface" ]] && { echo "(no interface given, abort)"; return 1; }
    require_running || return 1
    dc exec -T collector python -m collector scan "$iface"
}

cmd_upload_now() {
    require_running || return 1
    dc exec -T collector python -m collector upload-now
}

cmd_upload_test() {
    require_running || return 1
    dc exec -T collector python -m collector upload-test
}

cmd_config() {
    printf '%s== Effective config (%s, password redacted) ==%s\n' \
        "$C_HEAD" "$NETMON_ENV_FILE" "$C_OFF"
    if [[ ! -f "$NETMON_ENV_FILE" ]]; then
        echo "($NETMON_ENV_FILE not found — run: sudo netmon-wizard)"
        return 1
    fi
    sudo awk -F= '
        /^[[:space:]]*#/ || NF<2 { print; next }
        /PASSWORD/ || /SECRET/ || /TOKEN/ || /KEY/ {
            printf "%s=%s\n", $1, "***REDACTED***"; next
        }
        { print }
    ' "$NETMON_ENV_FILE" 2>/dev/null || awk -F= '
        /^[[:space:]]*#/ || NF<2 { print; next }
        /PASSWORD/ || /SECRET/ || /TOKEN/ || /KEY/ {
            printf "%s=%s\n", $1, "***REDACTED***"; next
        }
        { print }
    ' "$NETMON_ENV_FILE"
}

cmd_restart() {
    printf '%s== Restarting containers ==%s\n' "$C_HEAD" "$C_OFF"
    dc restart
}

cmd_update() {
    printf '%s== Running auto-update now ==%s\n' "$C_HEAD" "$C_OFF"
    if [[ -x ./scripts/auto-update.sh ]]; then
        ./scripts/auto-update.sh
    else
        echo "scripts/auto-update.sh missing or not executable" >&2
        return 1
    fi
}

cmd_timers() {
    printf '%s== Update timer schedule ==%s\n' "$C_HEAD" "$C_OFF"
    systemctl list-timers --no-pager 'netmon-*.timer' 2>/dev/null || \
        echo "(no netmon timers installed — run ./scripts/install-auto-update.sh)"
    echo ""
    printf '%s== Last nightly update output ==%s\n' "$C_HEAD" "$C_OFF"
    journalctl -u netmon-update.service -n 20 --no-pager 2>/dev/null || \
        echo "(no journal entries yet)"
}

cmd_bundles() {
    printf '%s== Local bundle files (%s) ==%s\n' "$C_HEAD" "$NETMON_BUNDLES_DIR" "$C_OFF"
    if [[ -d "$NETMON_BUNDLES_DIR" ]] && [[ -n "$(ls -A "$NETMON_BUNDLES_DIR" 2>/dev/null)" ]]; then
        ls -lh "$NETMON_BUNDLES_DIR"
    else
        echo "(no local bundles yet)"
    fi
    echo ""
    printf '%s== Upload state (last 20 from db) ==%s\n' "$C_HEAD" "$C_OFF"
    if dc ps --status running 2>/dev/null | grep -q netmon-postgres; then
        dc exec -T postgres psql -U "${POSTGRES_USER:-netmon}" -d "${POSTGRES_DB:-netmon}" -c \
            "SELECT filename, built_at, uploaded_at, retry_count, last_error FROM bundle_uploads ORDER BY built_at DESC LIMIT 20;" 2>&1 || true
    fi
}

cmd_wizard() {
    if command -v netmon-wizard >/dev/null 2>&1; then
        sudo netmon-wizard "$@"
    elif [[ -x ./bin/netmon-wizard ]]; then
        sudo ./bin/netmon-wizard "$@"
    else
        echo "netmon-wizard not found. Re-run ./setup.sh to install it." >&2
        return 1
    fi
}

cmd_selftest() {
    require_running || return 1
    dc exec -T collector python -m collector selftest
}

cmd_version() {
    printf '%s== Version ==%s\n' "$C_HEAD" "$C_OFF"
    if git -C "$(pwd)" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local sha date branch
        sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
        date=$(git log -1 --format=%cd --date=short 2>/dev/null || echo "unknown")
        branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
        echo "  git:       $sha ($branch, $date)"
    fi
    echo "  collector: $(dc images collector 2>/dev/null | awk 'NR==2 {print $4}' || echo 'image not built yet')"
    if [[ -f "$NETMON_ENV_FILE" ]]; then
        local wizard_status
        if [[ -f "${NETMON_VAR_DIR:-/var/lib/netmon}/.wizard-done" ]]; then
            wizard_status="completed"
        else
            wizard_status="${C_WARN}not yet run${C_OFF}"
        fi
        printf "  wizard:    %b\n" "$wizard_status"
    fi
    echo "  paths:     env=$NETMON_ENV_FILE bundles=$NETMON_BUNDLES_DIR logs=$NETMON_LOG_DIR"
}

cmd_reboot() {
    echo ""
    printf '%sWARNING: this will reboot the entire box.%s\n' "$C_WARN" "$C_OFF"
    read -r -p "Type REBOOT (uppercase) to confirm: " confirm || confirm=""
    if [[ "$confirm" == "REBOOT" ]]; then
        echo "Rebooting in 5 seconds..."
        sleep 5
        sudo systemctl reboot
    else
        echo "(cancelled)"
    fi
}

cmd_ping() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        read -r -p "Host or IP to ping: " target || return 1
    fi
    require_running || return 1
    dc exec -T collector ping -c 4 -W 2 "$target"
}

cmd_dig() {
    local name="${1:-}"
    if [[ -z "$name" ]]; then
        read -r -p "DNS name to look up: " name || return 1
    fi
    require_running || return 1
    dc exec -T collector dig +short "$name"
}

cmd_help() {
    cat <<EOF
Usage: ./netmon [command] [args]

Interactive: run with no command for the menu (main + Configure / System / Diagnostics submenus).

Main commands:
  status         Container, identity, scan, upload, and disk overview
  logs           Tail live collector logs
  audit          Show the audit log (high-signal events)
  list           List recent scans
  scan [iface]   Run a manual scan (prompts if iface not given)
  upload-now     Force-build + upload the current bundle right now
  upload-test    Test SFTP connection
  restart        Restart containers
  update         Run auto-update.sh manually
  selftest       Run the collector's internal self-checks

Configure (delegates to netmon-wizard):
  wizard         Re-run the full wizard
  identity       Edit district/school/device labels
  sftp           Edit SFTP destination
  snmp           Edit SNMP communities
  cadence        Edit scan cadence (rescan interval / capture / poll)
  loglevel       Set log verbosity
  trunk          Set up VLAN trunk monitoring (many VLANs on one box)

System:
  config         Show /etc/netmon/netmon.env (passwords redacted)
  timers         Show update timer schedule + last run output
  bundles        Show local bundle files + upload state
  version        Show git SHA, image, and wizard status
  reboot         Reboot the box (asks for confirmation)
  rollback       Revert to previous version (code + image + DB)
  quick-rebuild  Rebuild containers, keep data + config
  factory-reset  Wipe everything, re-run wizard
  config-backup  Force an immediate config backup to SFTP
  config-restore Restore /etc/netmon from SFTP backup

Diagnostics:
  interfaces     List monitored interfaces (primary uplink vs secondary)
  ping [host]    Ping a host from inside the collector
  dig [name]     DNS lookup from inside the collector

  help           Show this help
EOF
}

# --- interactive submenus -------------------------------------------------

submenu_configure() {
    while true; do
        if [[ $HAVE_LIB -eq 1 ]]; then
            menu_header "Configure"
            menu_item 1 "Identity (district / school / device)"
            menu_item 2 "SFTP destination"
            menu_item 3 "SNMP communities"
            menu_item 4 "Scan cadence (rescan / capture / poll)"
            menu_item 5 "Log verbosity"
            menu_item 6 "VLAN trunk setup (monitor many VLANs on one box)"
            menu_item 7 "Show current config (redacted)"
            menu_item 8 "Re-run full wizard"
            menu_footer "b" "Back to main menu" "q" "Quit"
            local choice
            choice="$(menu_read)"
        else
            echo ""
            echo "Configure"
            echo "  1) Identity   2) SFTP   3) SNMP   4) Cadence"
            echo "  5) Log level  6) VLAN trunk  7) Show config  8) Full wizard"
            echo "  b) Back       q) Quit"
            read -r -p "Choice: " choice || choice="q"
        fi
        case "$choice" in
            1) cmd_wizard identity ;;
            2) cmd_wizard sftp ;;
            3) cmd_wizard snmp ;;
            4) cmd_wizard cadence ;;
            5) cmd_wizard loglevel ;;
            6) cmd_wizard trunk ;;
            7) cmd_config ;;
            8) cmd_wizard ;;
            b|B) return 0 ;;
            q|Q|exit|quit) return 99 ;;
            *) printf '%s(unknown choice: %s)%s\n' "$C_WARN" "$choice" "$C_OFF" ;;
        esac
        # After any write op, hint that a restart applies the change.
        # (6 = show config, read-only; no restart needed.)
        case "$choice" in
            1|2|3|4|5|7)
                echo ""
                printf '%sNote:%s settings updated. Restart containers (main menu option 8) to apply.\n' \
                    "$C_INFO" "$C_OFF"
                ;;
        esac
        pause_or_continue
    done
}

submenu_system() {
    while true; do
        if [[ $HAVE_LIB -eq 1 ]]; then
            menu_header "System"
            menu_item 1 "Bundle history (local + uploaded)"
            menu_item 2 "Update timer schedule + last run"
            menu_item 3 "Run update now"
            menu_item 4 "Version info"
            menu_item 5 "Reboot box"
            menu_section "Recovery"
            menu_item 6 "Rollback to previous version"
            menu_item 7 "Quick rebuild (keeps data + config)"
            menu_item 8 "Factory reset (wipes everything)"
            menu_item 9 "Restore config from SFTP backup"
            menu_footer "b" "Back to main menu" "q" "Quit"
            local choice
            choice="$(menu_read)"
        else
            echo ""
            echo "System"
            echo "  1) Bundles  2) Timers  3) Update now  4) Version  5) Reboot"
            echo "  6) Rollback  7) Quick rebuild  8) Factory reset  9) Restore from backup"
            echo "  b) Back     q) Quit"
            read -r -p "Choice: " choice || choice="q"
        fi
        case "$choice" in
            1) cmd_bundles ;;
            2) cmd_timers ;;
            3) cmd_update ;;
            4) cmd_version ;;
            5) cmd_reboot ;;
            6) if declare -f lifecycle_rollback >/dev/null; then lifecycle_rollback; else echo "(lib/lifecycle.sh not loaded — run setup.sh)"; fi ;;
            7) if declare -f lifecycle_quick_rebuild >/dev/null; then lifecycle_quick_rebuild; else echo "(lib/lifecycle.sh not loaded — run setup.sh)"; fi ;;
            8) if declare -f lifecycle_factory_reset >/dev/null; then lifecycle_factory_reset; else echo "(lib/lifecycle.sh not loaded — run setup.sh)"; fi ;;
            9) sudo netmon-config-restore ;;
            b|B) return 0 ;;
            q|Q|exit|quit) return 99 ;;
            *) printf '%s(unknown choice: %s)%s\n' "$C_WARN" "$choice" "$C_OFF" ;;
        esac
        pause_or_continue
    done
}

submenu_diagnostics() {
    while true; do
        if [[ $HAVE_LIB -eq 1 ]]; then
            menu_header "Diagnostics"
            menu_item 1 "Monitored interfaces (primary / secondary)"
            menu_item 2 "Ping a host (from inside collector)"
            menu_item 3 "DNS lookup (dig)"
            menu_item 4 "Run collector self-test"
            menu_footer "b" "Back to main menu" "q" "Quit"
            local choice
            choice="$(menu_read)"
        else
            echo ""
            echo "Diagnostics"
            echo "  1) Interfaces  2) Ping  3) DNS lookup  4) Self-test"
            echo "  b) Back  q) Quit"
            read -r -p "Choice: " choice || choice="q"
        fi
        case "$choice" in
            1) cmd_interfaces ;;
            2) cmd_ping ;;
            3) cmd_dig ;;
            4) cmd_selftest ;;
            b|B) return 0 ;;
            q|Q|exit|quit) return 99 ;;
            *) printf '%s(unknown choice: %s)%s\n' "$C_WARN" "$choice" "$C_OFF" ;;
        esac
        pause_or_continue
    done
}

# --- main interactive menu -------------------------------------------------

main_menu_once() {
    if [[ $HAVE_LIB -eq 1 ]]; then
        menu_header "NetMon — Operations"
        menu_item 1 "Status overview"
        menu_item 2 "Tail live logs"
        menu_item 3 "Audit log (high-signal events)"
        menu_item 4 "Recent scans"
        menu_item 5 "Manual scan"
        menu_item 6 "Force upload now"
        menu_item 7 "Test SFTP connection"
        menu_item 8 "Restart containers"
        menu_section "Submenus"
        menu_item "c" "Configure ▶"
        menu_item "s" "System ▶"
        menu_item "d" "Diagnostics ▶"
        menu_footer "q" "Quit"
        local choice
        choice="$(menu_read)"
    else
        cat <<EOF

NetMon
   1) Status      2) Logs        3) Audit       4) Scans       5) Manual scan
   6) Upload now  7) Test SFTP   8) Restart
   c) Configure ▶  s) System ▶  d) Diagnostics ▶  q) Quit
EOF
        read -r -p "Choice: " choice || choice="q"
    fi
    case "$choice" in
         1) cmd_status; pause_or_continue ;;
         2) cmd_logs; pause_or_continue ;;
         3) cmd_audit; pause_or_continue ;;
         4) cmd_list_scans; pause_or_continue ;;
         5) cmd_scan; pause_or_continue ;;
         6) cmd_upload_now; pause_or_continue ;;
         7) cmd_upload_test; pause_or_continue ;;
         8) cmd_restart; pause_or_continue ;;
         c|C) local rc=0; submenu_configure || rc=$?; [[ $rc -eq 99 ]] && return 99 ;;
         s|S) local rc=0; submenu_system || rc=$?; [[ $rc -eq 99 ]] && return 99 ;;
         d|D) local rc=0; submenu_diagnostics || rc=$?; [[ $rc -eq 99 ]] && return 99 ;;
         q|Q|exit|quit) return 99 ;;
        *) printf '%s(unknown choice: %s)%s\n' "$C_WARN" "$choice" "$C_OFF" ;;
    esac
    return 0
}

# --- dispatch --------------------------------------------------------------

if [[ $# -eq 0 ]]; then
    while true; do
        main_menu_once || { rc=$?; [[ $rc -eq 99 ]] && exit 0; exit $rc; }
    done
else
    case "${1:-}" in
        status)        cmd_status ;;
        logs)          cmd_logs ;;
        audit)         cmd_audit ;;
        list)          cmd_list_scans ;;
        scan)          shift; cmd_scan "${1:-}" ;;
        upload-now)    cmd_upload_now ;;
        upload-test)   cmd_upload_test ;;
        config)        cmd_config ;;
        restart)       cmd_restart ;;
        update)        cmd_update ;;
        timers)        cmd_timers ;;
        bundles)       cmd_bundles ;;
        wizard|reconfigure)   shift; cmd_wizard "$@" ;;
        identity)      cmd_wizard identity ;;
        sftp)          cmd_wizard sftp ;;
        snmp)          cmd_wizard snmp ;;
        cadence)       cmd_wizard cadence ;;
        loglevel|log)  cmd_wizard loglevel ;;
        trunk|vlan)    cmd_wizard trunk ;;
        interfaces|ifaces) cmd_interfaces ;;
        selftest)      cmd_selftest ;;
        version)       cmd_version ;;
        reboot)        cmd_reboot ;;
        ping)          shift; cmd_ping "${1:-}" ;;
        dig)           shift; cmd_dig "${1:-}" ;;
        rollback)      if declare -f lifecycle_rollback >/dev/null; then lifecycle_rollback; else echo "lib/lifecycle.sh not present"; exit 1; fi ;;
        quick-rebuild) if declare -f lifecycle_quick_rebuild >/dev/null; then lifecycle_quick_rebuild; else echo "lib/lifecycle.sh not present"; exit 1; fi ;;
        factory-reset) if declare -f lifecycle_factory_reset >/dev/null; then lifecycle_factory_reset; else echo "lib/lifecycle.sh not present"; exit 1; fi ;;
        config-backup) sudo docker compose exec -T collector python -m collector config-backup ;;
        config-restore) shift; sudo netmon-config-restore "$@" ;;
        help|-h|--help) cmd_help ;;
        *) cmd_help; exit 1 ;;
    esac
fi
