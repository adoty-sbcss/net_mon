# Legacy in-repo state — kept ignored in case anyone re-creates these locally.
# After Phase 1, the canonical locations are:
#   /etc/netmon/netmon.env, /etc/netmon/snmp.yaml
#   /var/lib/netmon/bundles, /var/log/netmon
.env
bundles/
logs/
config/snmp.yaml

# Site provisioning defaults — contains the shared enrollment bootstrap key
# (a secret). This repo is public; never commit the real file. Only the
# *.example template is tracked. See lib/provisioning.sh.
config/provisioning.env

**/__pycache__/
*.pyc
.venv/
.idea/
.vscode/
.claude/

# Python build artifacts
*.egg-info/
build/
dist/
__pycache__/
